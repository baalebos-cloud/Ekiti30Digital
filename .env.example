# --- Ask Ekiti: embeddings / pgvector -----------------------------------
# Single source of truth for the embedding vector size. Both the Python
# retrieval code (13_Knowledge_Base/tools/ask_ekiti_retrieval.py) and the
# pgvector column definition in the database migration MUST use this same
# number -- pgvector's column dimension is fixed at table-creation time and
# cannot be changed without a migration, so do not hard-code a dimension in
# more than one place.
#
# Leave at 0 until the embeddings provider is confirmed (owner: Member 2 +
# Faith, per the Ask Ekiti spec Part C backend item). Once set, the
# corresponding pgvector column should be created as vector(<this number>).
ASK_EKITI_EMBEDDING_DIM=0
