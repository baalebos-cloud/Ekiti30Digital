
DATABASE_URL=sqlite:///./dev.db

# Comma-separated list of allowed CORS origins (no spaces needed around commas).
# Example with multiple origins: FRONTEND_ORIGIN=http://localhost:3000,https://staging.example.com
FRONTEND_ORIGIN=http://localhost:3000

# --- Ask Ekiti: LLM / embeddings gateway config (not required yet) --------
# All optional; the app runs fine with none of them set.
# Single gateway endpoint that houses all providers internally — no per-provider keys needed here.
# ASK_EKITI_LLM_WEBHOOK_URL=
# ASK_EKITI_LLM_WEBHOOK_KEY=
# LLM_MODEL=
# Embeddings run locally via sentence-transformers; these are the defaults.
# EMBEDDING_PROVIDER=sentence-transformers
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_DIMENSIONS=384

# --- Media uploads (Cloudinary) --------------------------------------------
# Public values — returned to the browser, which uploads directly to
# Cloudinary with an unsigned preset.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_UPLOAD_PRESET=
# Secret — used server-side only to verify each upload via the Cloudinary
# Admin API before it's recorded (and by scripts/setup_cloudinary_preset.py).
# Set them in your local .env / deployment secrets; never put real values in
# this file. Left unset, POST /api/uploads/{id}/complete returns 503.
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Admin auth ------------------------------------------------------------
# Must match NEXTAUTH_SECRET in frontend/.env.local. Left unset, every admin
# and upload route rejects requests. Generate with e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# NEXTAUTH_SECRET=
