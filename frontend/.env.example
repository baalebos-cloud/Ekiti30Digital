NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Admin auth (NextAuth) -------------------------------------------------
# Placeholders only — put real values in .env.local (gitignored), never here.
#
# The site's public URL (required by NextAuth in production).
# NEXTAUTH_URL=http://localhost:3000
#
# Signs admin session JWTs. Must equal NEXTAUTH_SECRET in the backend's env so
# it can verify them. Generate with e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# NEXTAUTH_SECRET=
#
# Admin accounts, generated by `node scripts/hash-admin-password.mjs`
# (base64-encoded list of emails + bcrypt hashes; no plaintext passwords).
# ADMIN_USERS=
